# Copy to .env and fill in. docker compose reads .env from the repo root.

# Bootstrap tokens, required. The compose runners send the agent token to register with the hub, the
# example check sends the client token to open a browser session (?gateway_token=...). They work even
# while MySQL is down. Give other hosts and checks their own tokens from the Grid UI's Access page.
# Generate with: openssl rand -hex 32
GATEWAY_AGENT_TOKEN=
GATEWAY_CLIENT_TOKEN=
# Managed tokens: how long the hub caches a lookup (so a revoked token still opens new connections this
# long), and how often it re-checks connected agents and closes revoked or expired ones (seconds).
#TOKEN_CACHE_S=10
#TOKEN_RECHECK_S=15

# Host port the hub publishes. The only port runner hosts need to reach.
GATEWAY_PORT=4500
# Hub URL the checks use and the Grid UI shows for each slot.
GATEWAY_URL=ws://hub:4500
# Playwright run-server processes per runner container.
RUNNER_SLOTS=4
# Seconds the hub keeps a gone ephemeral node (the compose runners) before removing it and its slots.
EPHEMERAL_GRACE_S=120

# A slot with this many consecutive connect failures is skipped, and retried once per cooldown
# (seconds). Used by the checks' slot selection and the Grid UI alike.
SLOT_FAIL_THRESHOLD=3
SLOT_FAIL_COOLDOWN_S=300

# Required for the Grid UI's management actions (force release, reset, forget) when it is exposed,
# and always for its Access page (managed agent and client tokens). Generate with: openssl rand -hex 32
GRID_ADMIN_TOKEN=
# Extra host names (comma list) the Grid UI accepts actions through, e.g. a DNS alias or proxy name.
GRID_UI_ALLOWED_HOSTS=

# MySQL service from docker-compose.mysql.yaml.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=orchestrator
MYSQL_USER=orchestrator
MYSQL_PASSWORD=orchestrator

# An existing MySQL server instead (leave out docker-compose.mysql.yaml):
#DB_HOST=
#DB_PORT=3306
#DB_NAME=orchestrator
#DB_USER=orchestrator
#DB_PASSWORD=
