# Copy to .env and fill in. docker compose reads .env from the repo root.

# Bootstrap tokens, required. The compose runners send the agent token to register with the hub, the
# example check sends the client token to open a browser session (ws://hub:4500/connect?gateway_token=...).
# They work even while MySQL is down. Give other hosts and checks their own tokens from the Grid UI's
# Access page.
# Generate with: openssl rand -hex 32
GATEWAY_AGENT_TOKEN=
GATEWAY_CLIENT_TOKEN=
# Managed tokens: how long the hub caches a lookup (so a revoked token still opens new connections this
# long), and how often it re-checks connected agents and closes revoked or expired ones (seconds).
#TOKEN_CACHE_S=10
#TOKEN_RECHECK_S=15

# Host port the hub publishes. The only port runner hosts need to reach.
GATEWAY_PORT=4500
# Hub URL the checks use and the Grid UI shows. Checks connect to <GATEWAY_URL>/connect and the hub
# picks a free slot for the browser they launch. Not a /connect/<node>/<slot> address: those are gone.
GATEWAY_URL=ws://hub:4500
# Optional: keep the checks on one node (sent as ?node=). The hub still picks the slot.
#GATEWAY_NODE=
# Playwright run-server processes per runner container.
RUNNER_SLOTS=4
# Seconds the hub keeps a gone ephemeral node (the compose runners) before removing it and its slots.
EPHEMERAL_GRACE_S=120

# A slot with this many consecutive connect failures is skipped, and retried once per cooldown
# (seconds). Used by the hub's routing and the Grid UI alike.
SLOT_FAIL_THRESHOLD=3
SLOT_FAIL_COOLDOWN_S=300

# /connect: a client waits up to GATEWAY_QUEUE_TIMEOUT_S seconds for a free slot that offers its browser
# (0: no waiting), at most GATEWAY_QUEUE_MAX clients wait at once, and a client is tried on up to
# GATEWAY_CONNECT_ATTEMPTS slots before it gets the error.
#GATEWAY_QUEUE_TIMEOUT_S=60
#GATEWAY_QUEUE_MAX=200
#GATEWAY_CONNECT_ATTEMPTS=3

# A hub not heard from for this many seconds is taken for gone: another hub (or the next one to start)
# frees the slots it had claimed. Used by the hub and the Grid UI alike.
#GATEWAY_HUB_LEASE_S=90

# Required for the Grid UI's management actions (force release, reset, forget) when it is exposed, and
# always for its Access, MFA and Admin pages, unless single sign-on is set up; with single sign-on, a
# break-glass sign-in with every permission. Generate with: openssl rand -hex 32
GRID_ADMIN_TOKEN=
# Extra host names (comma list) the Grid UI accepts actions through, e.g. a DNS alias or proxy name.
GRID_UI_ALLOWED_HOSTS=
# Encrypts the authenticator (TOTP) seeds stored on the Grid UI's MFA page and the sign-ins checks save there.
# Until it is set the MFA page (which also needs GRID_ADMIN_TOKEN or single sign-on) takes no seeds and gives
# no codes, and checks can't save or reuse sign-ins. At least 16 characters. Keep it: seeds and saved sign-ins
# stored under one key don't decrypt under another (every check then signs in again). Generate with:
# openssl rand -hex 32
GRID_SECRETS_KEY=
# The client token compose's checks that use MFA codes or saved sign-ins (poc_totp_login, poc_signin_reuse) ask
# the Grid UI with, instead of GATEWAY_CLIENT_TOKEN: one made on the Access page by the person whose checks they
# are. Set it before taking GATEWAY_CLIENT_TOKEN out of the grid_ui service.
#GRID_MFA_TOKEN=

# Single sign-on for people, through your OpenID Connect identity provider (Entra ID, Google, Okta, Keycloak...).
# The issuer exactly as its ID tokens state it, e.g. https://login.microsoftonline.com/<tenant id>/v2.0. Setting
# it means grid actions need sign-in. GRID_ADMIN_TOKEN keeps working as a break-glass sign-in.
GRID_OIDC_ISSUER=
GRID_OIDC_CLIENT_ID=
GRID_OIDC_CLIENT_SECRET=
# The address people open the Grid UI at. Register <it>auth/callback as the redirect URI at the provider.
# Sign-in started at any other address is sent here first.
GRID_UI_PUBLIC_URL=
# People who are always admins: sub:<subject> or a verified email address, comma separated.
GRID_OIDC_ADMINS=
# The sign-in button reads "Sign in with <label>".
#GRID_OIDC_LABEL=single sign-on
# Scopes to ask for on top of openid email profile, space separated, e.g. groups for Okta.
#GRID_OIDC_SCOPES=
# The ID token's claims (comma list) whose values group mappings match, e.g. roles for Entra app roles.
#GRID_OIDC_GROUPS_CLAIM=groups
# auto, basic or post: set it when the client is registered for one method only.
#GRID_OIDC_CLIENT_AUTH=auto
# 1 also signs people out of the provider (not Okta, which needs an ID token the Grid UI doesn't keep).
#GRID_OIDC_END_SESSION=
# Extra CA certificates (PEM) for a provider behind a private CA, as a path inside the container.
#GRID_OIDC_CA_FILE=
# 1 allows plain http to a provider or public URL that isn't loopback. Development only.
#GRID_OIDC_ALLOW_HTTP=
# Leeway for the ID token's times (seconds), how long a sign-in lasts (hours), and how long unused (minutes,
# 0: no limit).
#GRID_OIDC_CLOCK_SKEW_S=60
#GRID_SESSION_HOURS=12
#GRID_SESSION_IDLE_MINUTES=120
# Whether the overview, activity and sessions need sign-in: signed-in (the default with single sign-on) or open.
#GRID_UI_READS=
# Reverse proxies in front of the Grid UI, so the sign-in limits and the audit log see people's addresses.
#GRID_UI_PROXY_HOPS=0
# How many days the Grid UI's audit log keeps (30 to 3650).
#GRID_AUDIT_DAYS=365

# MySQL service from docker-compose.mysql.yaml.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=orchestrator
MYSQL_USER=orchestrator
MYSQL_PASSWORD=orchestrator

# An existing MySQL server instead (leave out docker-compose.mysql.yaml):
#DB_HOST=
#DB_PORT=3306
#DB_NAME=orchestrator
#DB_USER=orchestrator
#DB_PASSWORD=
